{
  "info": {
    "name": "Transaction Ledger API (Protected)",
    "description": "Postman Collection for Transaction Ledger Backend API with JWT & API Key Authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "ledger-api-key-secret-2026",
      "type": "string"
    },
    {
      "key": "accountId",
      "value": "",
      "type": "string"
    },
    {
      "key": "accountBId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth - 1. Register User (Public)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.success && jsonData.data && jsonData.data.token) {",
              "    pm.collectionVariables.set('authToken', jsonData.data.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"alice_ledger\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"securePassword123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "Auth - 2. Login User (Public)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.success && jsonData.data && jsonData.data.token) {",
              "    pm.collectionVariables.set('authToken', jsonData.data.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"securePassword123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "Auth - 3. Get Current User Profile (Protected)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "me"]
        }
      }
    },
    {
      "name": "1. Create Account A (Protected)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.success && jsonData.data && jsonData.data.id) {",
              "    pm.collectionVariables.set('accountId', jsonData.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice Cooper\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/accounts",
          "host": ["{{baseUrl}}"],
          "path": ["accounts"]
        }
      }
    },
    {
      "name": "2. Create Account B (Protected)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.success && jsonData.data && jsonData.data.id) {",
              "    pm.collectionVariables.set('accountBId', jsonData.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Bob Marley\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/accounts",
          "host": ["{{baseUrl}}"],
          "path": ["accounts"]
        }
      }
    },
    {
      "name": "3. Get Account Balance (Protected)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}/balance",
          "host": ["{{baseUrl}}"],
          "path": ["accounts", "{{accountId}}", "balance"]
        }
      }
    },
    {
      "name": "4. Credit Account A (100) (Protected)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"credit\",\n  \"amount\": 100,\n  \"description\": \"Initial deposit\",\n  \"reference_id\": \"ref-alice-001\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["accounts", "{{accountId}}", "transactions"]
        }
      }
    },
    {
      "name": "5. Credit Account A again (50) (Protected)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"credit\",\n  \"amount\": 50,\n  \"description\": \"Bonus payment\",\n  \"reference_id\": \"ref-alice-002\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["accounts", "{{accountId}}", "transactions"]
        }
      }
    },
    {
      "name": "6. Debit Account A (30) (Protected)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"debit\",\n  \"amount\": 30,\n  \"description\": \"Grocery shopping\",\n  \"reference_id\": \"ref-alice-003\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["accounts", "{{accountId}}", "transactions"]
        }
      }
    },
    {
      "name": "7. Duplicate Reference Check (Expect 409 Conflict)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"credit\",\n  \"amount\": 100,\n  \"description\": \"Duplicate attempt\",\n  \"reference_id\": \"ref-alice-001\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["accounts", "{{accountId}}", "transactions"]
        }
      }
    },
    {
      "name": "8. Debit Insufficient Balance (Expect 400 Bad Request)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"debit\",\n  \"amount\": 9999,\n  \"description\": \"Excessive debit\",\n  \"reference_id\": \"ref-alice-excess\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["accounts", "{{accountId}}", "transactions"]
        }
      }
    },
    {
      "name": "9. Get Transaction History (Protected)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions?page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["accounts", "{{accountId}}", "transactions"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "10. Bonus: Transfer Funds (Account A -> Account B) (Protected)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source_account_id\": \"{{accountId}}\",\n  \"destination_account_id\": \"{{accountBId}}\",\n  \"amount\": 30,\n  \"description\": \"P2P transfer\",\n  \"reference_id\": \"transfer-unique-001\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/transfers",
          "host": ["{{baseUrl}}"],
          "path": ["transfers"]
        }
      }
    },
    {
      "name": "11. Test Protected Access with x-api-key Header",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-api-key", "value": "{{apiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}/balance",
          "host": ["{{baseUrl}}"],
          "path": ["accounts", "{{accountId}}", "balance"]
        }
      }
    }
  ]
}
