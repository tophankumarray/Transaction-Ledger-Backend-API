{
  "info": {
    "name": "Transaction Ledger API",
    "description": "Postman Collection for Transaction Ledger Backend API assignment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "accountId",
      "value": "",
      "type": "string"
    },
    {
      "key": "accountBId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "1. Create Account A",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.success && jsonData.data && jsonData.data.id) {",
              "    pm.collectionVariables.set('accountId', jsonData.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice Cooper\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/accounts",
          "host": ["{{baseUrl}}"],
          "path": ["accounts"]
        }
      }
    },
    {
      "name": "2. Create Account B (for Transfer)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.success && jsonData.data && jsonData.data.id) {",
              "    pm.collectionVariables.set('accountBId', jsonData.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Bob Marley\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/accounts",
          "host": ["{{baseUrl}}"],
          "path": ["accounts"]
        }
      }
    },
    {
      "name": "3. Get Account Balance",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}/balance",
          "host": ["{{baseUrl}}"],
          "path": ["accounts", "{{accountId}}", "balance"]
        }
      }
    },
    {
      "name": "4. Credit Account A (100)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"credit\",\n  \"amount\": 100,\n  \"description\": \"Initial deposit\",\n  \"reference_id\": \"ref-alice-001\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["accounts", "{{accountId}}", "transactions"]
        }
      }
    },
    {
      "name": "5. Credit Account A again (50)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"credit\",\n  \"amount\": 50,\n  \"description\": \"Bonus payment\",\n  \"reference_id\": \"ref-alice-002\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["accounts", "{{accountId}}", "transactions"]
        }
      }
    },
    {
      "name": "6. Debit Account A (30)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"debit\",\n  \"amount\": 30,\n  \"description\": \"Grocery shopping\",\n  \"reference_id\": \"ref-alice-003\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["accounts", "{{accountId}}", "transactions"]
        }
      }
    },
    {
      "name": "7. Duplicate Transaction Reference (Expect 409 Conflict)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"credit\",\n  \"amount\": 100,\n  \"description\": \"Duplicate attempt\",\n  \"reference_id\": \"ref-alice-001\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["accounts", "{{accountId}}", "transactions"]
        }
      }
    },
    {
      "name": "8. Debit Insufficient Balance (Expect 400 Bad Request)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"debit\",\n  \"amount\": 9999,\n  \"description\": \"Excessive debit\",\n  \"reference_id\": \"ref-alice-excess\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["accounts", "{{accountId}}", "transactions"]
        }
      }
    },
    {
      "name": "9. Get Transaction History (All, paginated)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions?page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["accounts", "{{accountId}}", "transactions"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "10. Filter Transaction History (Credit only)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions?type=credit",
          "host": ["{{baseUrl}}"],
          "path": ["accounts", "{{accountId}}", "transactions"],
          "query": [
            { "key": "type", "value": "credit" }
          ]
        }
      }
    },
    {
      "name": "11. Bonus: Transfer Funds (Account A -> Account B)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source_account_id\": \"{{accountId}}\",\n  \"destination_account_id\": \"{{accountBId}}\",\n  \"amount\": 30,\n  \"description\": \"P2P transfer\",\n  \"reference_id\": \"transfer-unique-001\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/transfers",
          "host": ["{{baseUrl}}"],
          "path": ["transfers"]
        }
      }
    }
  ]
}
